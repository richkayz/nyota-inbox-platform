# Frontend (Vite / Cloudflare Workers) — see gateway/.env.example for the backend.
#
# Setting VITE_GATEWAY_URL automatically switches the app to live mode.
# Leave it unset to fall back to the in-memory mock fixtures.
VITE_GATEWAY_URL=https://inbox.nyotaone.com/api

# Optional explicit override: mock | live
# VITE_API_MODE=live

# Legacy alias for VITE_GATEWAY_URL (same-origin deployments can use "/api").
# VITE_API_BASE_URL=/api
