# Runtime/build settings for the Nyota Inbox frontend on the VPS.
# Copy to /etc/nyota-frontend/env. Never commit the real file.

# Nitro listens locally; Plesk/nginx is the public HTTPS endpoint.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# Use the current browser hostname so each tenant reaches its matching
# gateway host through Plesk's /api reverse proxy.
VITE_GATEWAY_URL=/api
