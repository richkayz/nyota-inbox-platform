// Nyota Inbox Mail Gateway — MariaDB schema.
// APPLICATION METADATA ONLY. Email bodies, headers, and attachments live in
// Dovecot and are never persisted here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Logical account tied to a mailbox address. Created lazily on first successful
/// IMAP login; the password is NEVER stored — only its existence is recorded.
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  displayName   String?
  avatarUrl     String?  @db.VarChar(500)
  tenantId      String   @db.VarChar(64)
  role          Role     @default(USER)
  lastLoginAt   DateTime?
  /// Only ever set for the platform super-admin (no mailbox behind it):
  /// scrypt$<salt>$<hash>. Mailbox users authenticate against Dovecot.
  passwordHash  String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  contacts      Contact[]
  signatures    Signature[]
  preferences   Preference?
  notifications NotificationSetting?
  folderCache   FolderCache[]
  auditLogs     AuditLog[]

  @@index([tenantId])
}

enum Role {
  USER
  COMPANY_ADMIN
  SUPER_ADMIN
}

/// Hashed refresh tokens. Access tokens are stateless.
model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique @db.VarChar(128)
  userAgent  String?  @db.VarChar(255)
  ip         String?  @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  /// Denormalized tenant guard column (defense in depth — MariaDB has no RLS).
  tenantId  String?  @db.VarChar(64)
  email     String   @db.VarChar(320)
  name      String?  @db.VarChar(255)
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId, name])
}

model Signature {
  id        String   @id @default(uuid())
  userId    String
  /// Denormalized tenant guard column (defense in depth — MariaDB has no RLS).
  tenantId  String?  @db.VarChar(64)
  name      String   @db.VarChar(128)
  html      String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Preference {
  userId    String  @id
  theme     String  @default("system")   // light | dark | system
  density   String  @default("comfortable") // comfortable | compact
  locale    String  @default("en")
  timezone  String  @default("UTC")
  data      Json?                          // free-form per-plugin prefs

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationSetting {
  userId          String  @id
  desktopEnabled  Boolean @default(true)
  soundEnabled    Boolean @default(true)
  digestEnabled   Boolean @default(false)
  digestHourUtc   Int     @default(8)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Cached folder listing so the UI can render instantly before IMAP LIST completes.
/// Never contains message bodies.
model FolderCache {
  id             String   @id @default(uuid())
  userId         String
  /// Denormalized tenant guard column (defense in depth — MariaDB has no RLS).
  tenantId  String?  @db.VarChar(64)
  path           String   @db.VarChar(255)   // IMAP folder path e.g. "INBOX/Archive"
  name           String   @db.VarChar(255)
  role           String?  @db.VarChar(32)    // inbox|sent|drafts|spam|trash|archive|null
  delimiter      String   @db.VarChar(4)
  totalCount     Int      @default(0)
  unreadCount    Int      @default(0)
  uidValidity    BigInt?
  highestUid     BigInt?
  lastSyncedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, path])
  @@index([userId])
}

/// Tamper-evident append-only audit log.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  tenantId   String   @db.VarChar(64)
  type       String   @db.VarChar(64)
  email      String?  @db.VarChar(320)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  meta       Json?
  prevHash   String?  @db.VarChar(128)
  hash       String   @db.VarChar(128)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Multi-tenancy (Phase 1) — tenants are first-class rows, not free strings.
// `Tenant.id` IS the tenant slug so existing `User.tenantId` / `AuditLog.tenantId`
// values keep resolving without a destructive migration. No FK is declared on
// those legacy columns on purpose: rows created before this migration may point
// at a tenant that is auto-provisioned on first login instead.
// ---------------------------------------------------------------------------

/// A physical Plesk / Postfix / Dovecot host that serves one or more tenants.
model MailServer {
  id                    String   @id @default(uuid())
  name                  String   @unique @db.VarChar(64)
  hostname              String   @db.VarChar(255)
  region                String?  @db.VarChar(64)
  imapHost              String   @db.VarChar(255)
  imapPort              Int      @default(993)
  imapSecure            Boolean  @default(true)
  imapTlsServername     String?  @db.VarChar(255)
  imapRejectUnauthorized Boolean @default(true)
  smtpHost              String   @db.VarChar(255)
  smtpPort              Int      @default(587)
  smtpSecure            Boolean  @default(false)
  smtpTlsServername     String?  @db.VarChar(255)
  smtpRejectUnauthorized Boolean @default(true)
  status                String   @default("healthy") @db.VarChar(32) // healthy|degraded|offline
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenants Tenant[]
}

model Tenant {
  /// Slug — also the value stored in User.tenantId / AuditLog.tenantId.
  id              String   @id @db.VarChar(64)
  name            String   @db.VarChar(160)
  /// Canonical UI host, e.g. inbox.company.com
  primaryHostname String   @unique @db.VarChar(255)
  /// Comma-separated mailbox domains allowed to sign in on this tenant.
  allowedDomains  String   @default("") @db.VarChar(1024)
  plan            String   @default("starter") @db.VarChar(32)
  status          String   @default("active") @db.VarChar(32) // active|trial|provisioning|suspended
  mailboxLimit    Int      @default(25)
  /// Branding: { primary, accent, logoUrl, faviconUrl, welcomeMessage, supportEmail }
  branding        Json?
  /// True when the tenant was auto-provisioned from a login/host instead of onboarding.
  autoCreated     Boolean  @default(false)
  mailServerId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mailServer MailServer?    @relation(fields: [mailServerId], references: [id], onDelete: SetNull)
  domains    TenantDomain[]

  @@index([status])
}

/// Extra hostnames that resolve to a tenant (vanity hosts, legacy domains).
model TenantDomain {
  id        String   @id @default(uuid())
  tenantId  String   @db.VarChar(64)
  hostname  String   @unique @db.VarChar(255)
  pleskDomainId Int?  
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([pleskDomainId])
}
