// Nyota Inbox Mail Gateway — MariaDB schema.
// APPLICATION METADATA ONLY. Email bodies, headers, and attachments live in
// Dovecot and are never persisted here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Logical account tied to a mailbox address. Created lazily on first successful
/// IMAP login; the password is NEVER stored — only its existence is recorded.
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  displayName   String?
  tenantId      String   @db.VarChar(64)
  role          Role     @default(USER)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  contacts      Contact[]
  signatures    Signature[]
  preferences   Preference?
  notifications NotificationSetting?
  folderCache   FolderCache[]
  auditLogs     AuditLog[]

  @@index([tenantId])
}

enum Role {
  USER
  COMPANY_ADMIN
  SUPER_ADMIN
}

/// Hashed refresh tokens. Access tokens are stateless.
model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique @db.VarChar(128)
  userAgent  String?  @db.VarChar(255)
  ip         String?  @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  email     String   @db.VarChar(320)
  name      String?  @db.VarChar(255)
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId, name])
}

model Signature {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(128)
  html      String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Preference {
  userId    String  @id
  theme     String  @default("system")   // light | dark | system
  density   String  @default("comfortable") // comfortable | compact
  locale    String  @default("en")
  timezone  String  @default("UTC")
  data      Json?                          // free-form per-plugin prefs

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationSetting {
  userId          String  @id
  desktopEnabled  Boolean @default(true)
  soundEnabled    Boolean @default(true)
  digestEnabled   Boolean @default(false)
  digestHourUtc   Int     @default(8)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Cached folder listing so the UI can render instantly before IMAP LIST completes.
/// Never contains message bodies.
model FolderCache {
  id             String   @id @default(uuid())
  userId         String
  path           String   @db.VarChar(255)   // IMAP folder path e.g. "INBOX/Archive"
  name           String   @db.VarChar(255)
  role           String?  @db.VarChar(32)    // inbox|sent|drafts|spam|trash|archive|null
  delimiter      String   @db.VarChar(4)
  totalCount     Int      @default(0)
  unreadCount    Int      @default(0)
  uidValidity    BigInt?
  highestUid     BigInt?
  lastSyncedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, path])
  @@index([userId])
}

/// Tamper-evident append-only audit log.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  tenantId   String   @db.VarChar(64)
  type       String   @db.VarChar(64)
  email      String?  @db.VarChar(320)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  meta       Json?
  prevHash   String?  @db.VarChar(128)
  hash       String   @db.VarChar(128)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}
