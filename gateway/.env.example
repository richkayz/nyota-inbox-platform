# --- HTTP ---
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed CORS origins (the NyotaMail UI hosts).
CORS_ORIGINS=https://inbox.example.com,https://*.lovable.app

# --- Database (MariaDB) ---
# Metadata only — never email bodies.
DATABASE_URL="mysql://nyota:CHANGE_ME@127.0.0.1:3306/nyota_gateway"

# --- JWT ---
# 32+ byte random secrets. Rotate on incident.
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_BYTES
JWT_ACCESS_TTL=900               # 15 minutes
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_BYTES
JWT_REFRESH_TTL=1209600          # 14 days

# --- Session encryption key ---
# 32 bytes base64. Used to encrypt mailbox passwords held in memory.
SESSION_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# --- IMAP (Dovecot) ---
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_SECURE=true                 # true = implicit TLS on 993, false = STARTTLS on 143
IMAP_POOL_MAX=4                  # max concurrent IMAP connections per user

# --- SMTP (Postfix submission) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false                # STARTTLS on 587
SMTP_REQUIRE_TLS=true
# Postfix presents a cert for its own hostname. When connecting via 127.0.0.1,
# set this to that hostname so TLS validation (SNI) succeeds.
SMTP_TLS_SERVERNAME=mail.example.com
# Only set to false for self-signed / internal certificates.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Throttling ---
THROTTLE_TTL=60
THROTTLE_LIMIT=120               # per IP per minute

# Dovecot presents a cert for its own hostname. When connecting via 127.0.0.1,
# set this to that hostname so TLS validation (SNI) succeeds.
IMAP_TLS_SERVERNAME=mail.example.com
# Only set to false for self-signed / internal certificates.
IMAP_TLS_REJECT_UNAUTHORIZED=true
