# Nyota Inbox Mail Gateway -- production environment template.
# Copy this file to /etc/nyota-gateway/env on the VPS and replace every
# CHANGE_ME value. Never commit the real environment file.

# HTTP
PORT=4000
HOST=127.0.0.1
NODE_ENV=production
PUBLIC_GATEWAY_URL=https://inbox.example.com/api
CORS_ORIGINS=https://inbox.example.com
PLATFORM_HOSTNAME=platform.example.com

# MariaDB -- application metadata only; email remains in Dovecot.
DATABASE_URL="mysql://nyota:CHANGE_ME@127.0.0.1:3306/nyota_gateway"

# JWT -- generate each independently: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_CHARACTERS
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARACTERS
JWT_REFRESH_TTL=1209600

# 32-byte base64 key: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# IMAP / Dovecot
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_SECURE=true
IMAP_TLS_SERVERNAME=mail.example.com
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_POOL_MAX=4

# SMTP / Postfix submission
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_SERVERNAME=mail.example.com
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Abuse protection
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Platform super-admin. Generate the hash with:
# node scripts/hash-password.mjs
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
